---

import Base from '@/layouts/Base.astro';
import { SITE } from '@/config';
const subjects = ['Custom design', 'Repairs', 'Pieces & components', 'Other'];
export const prerender = true;
---
<Base title="Contact — EM Fine Studio" active="/contact"
      description="Contact EM Fine Studio — custom design, repairs, pieces & components.">
  <section class="py-14">
    <div class="mx-auto max-w-[720px] px-6">
      <p class="text-xs tracking-[0.22em] uppercase text-accent mb-3">Contact</p>
      <h1 class="text-[34px] lg:text-[46px]">Get in touch</h1>
      <div class="mt-6 flex flex-col gap-3 text-sm text-muted">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.75 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.108c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.763.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.447.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          <a class="hover:text-ink transition-colors" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-.875 1.744l-9.5 6.532a2.25 2.25 0 01-2.5 0l-9.5-6.532a2.25 2.25 0 01-.875-1.744v-.243"/></svg>
          <a class="hover:text-ink transition-colors" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.744M12 21a9.004 9.004 0 01-8.716-6.744M12 21c2.485 0 4.5-4.095 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.095-4.5-9S9.515 3 12 3m0 0h8m-8 0H4"/></svg>
          <span>{SITE.web}</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          <span>{SITE.address}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="mx-auto max-w-[720px] px-6 border border-line bg-accent-soft p-6 sm:p-8">
      <form id="contact-form" class="flex flex-col gap-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-name" class="block text-sm font-semibold mb-1.5">Name *</label>
            <input id="c-name" name="name" type="text" required minlength="2" maxlength="100"
                   class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent" />
          </div>
          <div>
            <label for="c-email" class="block text-sm font-semibold mb-1.5">Email *</label>
            <input id="c-email" name="email" type="email" required
                   class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent" />
          </div>
        </div>
        <div>
          <label for="c-subject" class="block text-sm font-semibold mb-1.5">Subject *</label>
          <select id="c-subject" name="subject" required
                  class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent">
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div>
          <label for="c-message" class="block text-sm font-semibold mb-1.5">Message *</label>
          <textarea id="c-message" name="message" rows="5" required minlength="2" maxlength="4000"
                    class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent"></textarea>
        </div>
        <button id="c-submit" type="submit"
                class="self-start bg-accent text-white px-7 py-3 text-sm font-semibold hover:bg-ink transition-colors">
          Send message
        </button>
        <p id="c-status" class="text-sm hidden"></p>
      </form>
    </div>
  </section>
</Base>
<script>
  import { initContactForm } from '@/scripts/contact-form';
  import { SITE } from '@/config';
  initContactForm(SITE.email);
</script>
