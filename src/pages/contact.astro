---

import Base from '@/layouts/Base.astro';
import { SITE } from '@/config';
const subjects = ['Custom design', 'Repairs', 'Pieces & components', 'Other'];
---
export const prerender = true;
<Base title="Contact — EM Fine Studio" active="/contact"
      description="Contact EM Fine Studio — custom design, repairs, pieces & components.">
  <section class="py-14">
    <div class="mx-auto max-w-[720px] px-6">
      <p class="text-xs tracking-[0.22em] uppercase text-accent mb-3">Contact</p>
      <h1 class="text-[34px] lg:text-[46px]">Get in touch</h1>
      <p class="mt-4 text-muted">
        <a class="text-accent font-semibold hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <br />
        {SITE.suburb}
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="mx-auto max-w-[720px] px-6 border border-line bg-accent-soft p-6 sm:p-8">
      <form id="contact-form" class="flex flex-col gap-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-name" class="block text-sm font-semibold mb-1.5">Name *</label>
            <input id="c-name" name="name" type="text" required minlength="2"
                   class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent" />
          </div>
          <div>
            <label for="c-email" class="block text-sm font-semibold mb-1.5">Email *</label>
            <input id="c-email" name="email" type="email" required
                   class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent" />
          </div>
        </div>
        <div>
          <label for="c-subject" class="block text-sm font-semibold mb-1.5">Subject *</label>
          <select id="c-subject" name="subject" required
                  class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent">
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div>
          <label for="c-message" class="block text-sm font-semibold mb-1.5">Message *</label>
          <textarea id="c-message" name="message" rows="5" required minlength="2"
                    class="w-full border border-line bg-bg px-3 py-2.5 text-sm focus:outline-none focus:border-accent"></textarea>
        </div>
        <button id="c-submit" type="submit"
                class="self-start bg-accent text-white px-7 py-3 text-sm font-semibold hover:bg-ink transition-colors">
          Send message
        </button>
        <p id="c-status" class="text-sm hidden"></p>
      </form>
    </div>
  </section>
</Base>
<script>
  import { initContactForm } from '@/scripts/contact-form';
  import { SITE } from '@/config';
  initContactForm(SITE.email);
</script>
