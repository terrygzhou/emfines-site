---

import Base from '@/layouts/Base.astro';
export const prerender = true;
---
<Base title="Jewellery repairs — EM Fine Studio" active="/repairs"
      description="Stone replacements, prong work, chain repair, resizing, polishing and heirloom restoration. Treasured items handled with care.">
  <section class="pt-14 pb-8">
    <div class="mx-auto max-w-[720px] px-6">
      <p class="text-xs tracking-[0.22em] uppercase text-accent mb-3">Repairs</p>
      <h1 class="text-[34px] lg:text-[46px] leading-tight">Bring your treasured piece back.</h1>
      <p class="mt-4 text-[16px] text-muted leading-relaxed">
        From a broken chain to a faded heirloom — careful, considered repair work on the pieces that matter.
      </p>
    </div>
  </section>

  <section class="pb-14">
    <div class="mx-auto max-w-[720px] px-6">
      <h2 class="text-[26px] mb-5">What we fix</h2>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-3.5 text-[15px]">
        <ul class="grid gap-3.5">
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Stone replacements</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Prong work</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Ring resizing</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Ring &amp; bracelet repairs</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Pearl drilling &amp; re-drilling</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Pearl restringing &amp; re-threading</li>
        </ul>
        <ul class="grid gap-3.5">
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Soldering &amp; brazing</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Chain repair</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Polishing &amp; restoring</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Pearl gluing &amp; setting</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Jewellery cleaning</li>
            <li class="flex gap-3"><span class="text-accent font-display">—</span> Heirloom piece restoration</li>
        </ul>
      </div>

      <figure class="mt-12 mb-2">
        <img src="/assets/repairs-bench-tools-01.jpg" alt="Worn bench pliers and nippers on the workshop rack, a gold ring resting on a tool pivot" loading="lazy"
             class="w-full h-auto rounded-xl shadow-lg" />
        <figcaption class="mt-3 text-center text-[13px] tracking-wide text-muted">
          The bench tools that bring pieces back to life.
        </figcaption>
      </figure>

      <h2 class="text-[26px] mt-12 mb-4">Pearl re-stranding</h2>
      <p class="text-[15px] text-muted leading-relaxed">
        Worn knots, tired silk, or a strand that no longer sits smoothly? We re-string your
        pearls by hand on new silk, with proper knots and a secure clasp — the same care a
        strand deserves for the next generation.
      </p>
      <figure class="mt-6 mb-2">
        <img src="/assets/repairs-pearl-restrans-01.jpg" alt="Double-strand pearl necklace with diamond accents and a floral diamond brooch centerpiece on a black display bust" loading="lazy"
             class="w-full max-w-[420px] h-auto rounded-xl shadow-lg" />
        <figcaption class="mt-3 text-center text-[13px] tracking-wide text-muted">
          A re-stranded double strand, restored and ready to wear.
        </figcaption>
      </figure>

      <h2 class="text-[26px] mt-12 mb-6">The process</h2>
      <ol class="flex flex-col gap-4 text-[15px] text-muted">
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent text-white text-[13px] font-semibold flex items-center justify-center">1</span>
          <span class="pt-1">Send photos and a description of what's wrong.</span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent text-white text-[13px] font-semibold flex items-center justify-center">2</span>
          <span class="pt-1">We quote, and you approve the cost before we start.</span>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent text-white text-[13px] font-semibold flex items-center justify-center">3</span>
          <span class="pt-1">Your piece is repaired and returned.</span>
        </li>
      </ol>

      <div class="mt-12 border-t pt-8">
        <div class="grid sm:grid-cols-2 gap-4 text-[14px] text-muted">
          <div>
            <p class="text-xs tracking-[0.18em] uppercase text-accent mb-1.5">Pricing</p>
            <p>By quote — we look at the piece first, then you approve the cost before we start.</p>
          </div>
          <div>
            <p class="text-xs tracking-[0.18em] uppercase text-accent mb-1.5">Turnaround</p>
            <p>3–10 working days, depending on the repair.</p>
          </div>
        </div>
        <p class="mt-6 text-[15px] italic text-muted">Treasured items handled with care and attention to detail.</p>
        <div class="mt-6">
          <a href="/contact" class="inline-block bg-accent text-white px-7 py-3.5 text-sm font-semibold hover:bg-ink transition-colors">
            Ask about a repair
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
