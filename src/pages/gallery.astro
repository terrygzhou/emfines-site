---
import Base from '@/layouts/Base.astro';
import { assets } from '@/generated/assets-manifest';
import { groupByCategory } from '@/lib/gallery';

const groups = groupByCategory(assets);

// Interleave: split by aspect-ratio into portrait / square / landscape buckets,
// then round-robin so tall and wide images alternate evenly.
// Returns items tagged with size: 'large' (landscape) or 'small' (portrait/square).
function interleave(items: typeof assets) {
  if (items.length < 4) return items;
  const portrait: Array<{ it: (typeof items)[number]; large: boolean }> = [];
  const square: Array<{ it: (typeof items)[number]; large: boolean }> = [];
  const landscape: Array<{ it: (typeof items)[number]; large: boolean }> = [];
  for (const it of items) {
    const r = it.width && it.height ? it.width / it.height : 1.5;
    const entry = { it, large: r > 1.05 };
    if (r < 0.95) portrait.push(entry);
    else if (r > 1.05) landscape.push(entry);
    else square.push(entry);
  }
  // Round-robin: portrait, square, landscape, portrait, square, landscape…
  const buckets = [portrait, square, landscape];
  const out: Array<{ it: (typeof items)[number]; large: boolean }> = [];
  let maxLen = 0;
  for (const b of buckets) maxLen = Math.max(maxLen, b.length);
  for (let i = 0; i < maxLen; i++) {
    for (const b of buckets) {
      if (i < b.length) out.push(b[i]);
    }
  }
  return out;
}

const filterBtn =
  'border border-line px-3.5 py-1.5 text-xs uppercase tracking-[0.14em] text-muted transition-colors hover:border-ink hover:text-ink';
export const prerender = true;
---
<Base
  title="Gallery — EM Fine Studio"
  active="/gallery"
  description="Every piece and component from the EM Fine Studio workshop, grouped by category."
>
  <section class="py-14">
    <div class="mx-auto max-w-[720px] px-6">
      <p class="text-xs tracking-[0.22em] uppercase text-accent mb-3">The gallery</p>
      <h1 class="text-[34px] lg:text-[46px]">From the bench.</h1>
      <p class="mt-4 text-muted max-w-[52ch]">
        Pieces, components and details from our studio — documented as they are made, finished
        and selected.
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="mx-auto max-w-[1240px] px-6">
      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter gallery by category">
        <button
          type="button"
          data-gallery-filter="all"
          class:list={[filterBtn, 'border-ink text-ink']}
          aria-pressed="true">
          All ({assets.length})
        </button>
        {groups.map((g) => (
          <button type="button" data-gallery-filter={g.category} class:list={[filterBtn]} aria-pressed="false">
            {g.category} ({g.items.length})
          </button>
        ))}
      </div>

      {groups.map((g) => {
        const entries = interleave(g.items);
        return (
          <section data-gallery-section={g.category} class="mb-14 last:mb-0">
            <h2 class="text-[26px] mb-6 flex items-baseline gap-3">
              {g.category} <span class="text-base text-muted align-super">{g.items.length}</span>
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 auto-rows-min">
              {entries.map(({ it, large }) => (
                  <figure
                    class:list={[
                      'm-0 border border-line bg-bg overflow-hidden flex flex-col items-center',
                      large ? 'col-span-2' : ''
                    ]}
                  >
                    <div class="w-full flex justify-center">
                      {it.width && it.height ? (
                        <img
                          src={it.src}
                          width={it.width}
                          height={it.height}
                          loading="lazy"
                          decoding="async"
                          alt={it.description}
                          class:list={[
                            'h-auto block',
                            large ? 'max-w-full' : 'max-w-[70%] md:max-w-[60%] xl:max-w-[55%]'
                          ]}
                        />
                      ) : (
                        <img
                          src={it.src}
                          loading="lazy"
                          decoding="async"
                          alt={it.description}
                          class="max-w-[70%] h-auto block"
                        />
                      )}
                    </div>
                    <figcaption class="w-full px-3 py-2.5 text-xs text-muted border-t border-line leading-snug text-center">
                      {it.description}
                    </figcaption>
                  </figure>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</Base>
<script>
  import { initGalleryFilter } from '@/scripts/gallery-filter';
  initGalleryFilter();
</script>
