---
import Base from '@/layouts/Base.astro';
import { assets } from '@/generated/assets-manifest';
import { groupByCategory } from '@/lib/gallery';

const groups = groupByCategory(assets);

// Interleave: alternate between the two most extreme aspect-ratio halves
// so wide/tall images break up the rhythm and create a visual zig-zag.
function interleave(items: typeof assets) {
  if (items.length < 4) return items;
  const withRatio = items
    .map((it) => ({ it, r: it.width && it.height ? it.width / it.height : 1.5 }))
    .sort((a, b) => a.r - b.r);
  const n = withRatio.length;
  const half = Math.floor(n / 2);
  const left = withRatio.slice(0, half);
  const right = withRatio.slice(half);
  const out: typeof items = [];
  const max = Math.max(left.length, right.length);
  for (let i = 0; i < max; i++) {
    // zig-zag: take from left, right, left, right…
    if (i < left.length) out.push(left[i].it);
    if (i < right.length) out.push(right[i].it);
  }
  return out;
}

const filterBtn =
  'border border-line px-3.5 py-1.5 text-xs uppercase tracking-[0.14em] text-muted transition-colors hover:border-ink hover:text-ink';
export const prerender = true;
---
<Base
  title="Gallery — EM Fine Studio"
  active="/gallery"
  description="Every piece and component from the EM Fine Studio workshop, grouped by category."
>
  <section class="py-14">
    <div class="mx-auto max-w-[720px] px-6">
      <p class="text-xs tracking-[0.22em] uppercase text-accent mb-3">The gallery</p>
      <h1 class="text-[34px] lg:text-[46px]">From the bench.</h1>
      <p class="mt-4 text-muted max-w-[52ch]">
        Pieces, components and details from our studio — documented as they are made, finished
        and selected.
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="mx-auto max-w-[1240px] px-6">
      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter gallery by category">
        <button
          type="button"
          data-gallery-filter="all"
          class:list={[filterBtn, 'border-ink text-ink']}
          aria-pressed="true">
          All ({assets.length})
        </button>
        {groups.map((g) => (
          <button type="button" data-gallery-filter={g.category} class:list={[filterBtn]} aria-pressed="false">
            {g.category} ({g.items.length})
          </button>
        ))}
      </div>

      {groups.map((g) => {
        const items = interleave(g.items);
        return (
          <section data-gallery-section={g.category} class="mb-14 last:mb-0">
            <h2 class="text-[26px] mb-6 flex items-baseline gap-3">
              {g.category} <span class="text-base text-muted align-super">{g.items.length}</span>
            </h2>
            <div class="columns-2 md:columns-3 xl:columns-4 gap-4 [column-gap:16px]">
              {items.map((item) => (
                  <figure class="m-0 mb-4 break-inside-avoid border border-line bg-bg overflow-hidden">
                    {item.width && item.height ? (
                      <img
                        src={item.src}
                        width={item.width}
                        height={item.height}
                        loading="lazy"
                        decoding="async"
                        alt={item.description}
                        class="w-full h-auto block"
                      />
                    ) : (
                      <div class="aspect-[3/2] overflow-hidden">
                        <img
                          src={item.src}
                          loading="lazy"
                          decoding="async"
                          alt={item.description}
                          class="w-full h-full object-cover"
                        />
                      </div>
                    )}
                    <figcaption class="px-3 py-2.5 text-xs text-muted border-t border-line leading-snug">
                      {item.description}
                    </figcaption>
                  </figure>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</Base>
<script>
  import { initGalleryFilter } from '@/scripts/gallery-filter';
  initGalleryFilter();
</script>
