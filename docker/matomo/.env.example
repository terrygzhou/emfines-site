# Matomo local deployment — copy to `.env` (gitignored) and edit.
#   cp .env.example .env
# These values are local-dev only. Real credentials stay in .env (never commit it).

# --- MySQL / MariaDB (matomo-db) ---------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MATOMO_DB_DATABASE=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=change-me-matomo

# --- Matomo app ----------------------------------------------------------
# Port the browser uses to reach the box. 8080 avoids clashing with nginx:80.
MATOMO_PORT=8080
# Base URL the embed + dashboard use. Add `matomo.local` -> <host IP> to
# /etc/hosts (or use the box's LAN IP / FQDN) so the site's LAN build can
# resolve it. Match this to src/config.ts -> matomo.host.
MATOMO_APP_BASEURL=http://matomo.local:8080
# Super-admin credentials for the one-off install.php step (first boot).
# Note: matomo/core does NOT auto-create the admin from env vars — create the
# account at install.php and record it here for your own reference. The compose
# stack only reads the MARIADB_* / MATOMO_* variables above.
MATOMO_ADMIN_USER=admin
MATOMO_ADMIN_PASSWORD=change-me-admin
MATOMO_ADMIN_EMAIL=studio@emfines.com.au
